<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Recall 独立可选 APK（MBM v1.0.26）。
      本 APK 是 MBM 系里唯一声明 AccessibilityService 的包；主输入法
      org.fcitx.fcitx5.android 不再声明任何无障碍服务。
    -->

    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
      MBM v1.0.32（隐私合规·权限最小化）：
      本 APK 为全离线组件——OCR 推理、词库、检索均在本机完成，代码中不存在
      任何网络调用。onnxruntime-android 的 AAR 清单会带入 INTERNET /
      ACCESS_NETWORK_STATE（供其可选的 Microsoft 遥测使用）及
      TelemetryInitializer Provider；本产品既不启用该遥测，也不具备联网
      能力，故在合并清单中显式移除，与主输入法「零网络权限」的定位一致。
    -->
    <uses-permission android:name="android.permission.INTERNET"
        tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />

    <!--
      MBM v1.0.33（隐私合规·R1 凭证门已实装）：
      RecallActivity 的「查看与填充」门前要求设备凭证验证
      （BiometricPrompt + BIOMETRIC_STRONG|DEVICE_CREDENTIAL），
      故恢复 androidx.biometric 的 AAR 带入的这两个权限声明。
      注意该门只挡 UI、不参与数据库密钥派生；设备未设置任何凭证时
      canAuthenticate 失败，代码走降级路径（保持可用 + 记审计日志）。
      此前 v1.0.32 曾因门控未接入而 tools:node="remove" 移除它们。
    -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />

    <!-- 只有与本 APK 同签名的调用方（即主输入法）可以拉起 RecallActivity -->
    <permission
        android:name="${applicationId}.permission.LAUNCH"
        android:protectionLevel="signature" />

    <application
        android:name=".RecallApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/full_backup_content"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MbmActivity">

        <!--
          Recall 时间线：数据全在本 APK 私有目录的 SQLCipher 加密库中。
          MBM v1.0.26 / P1-6（Android 17「旋转后恢复默认 IME 可见性」）：
          本页有搜索输入框（EditText），旋转后系统不再自动恢复软键盘可见性。
          正确做法是让 Activity 自己承接配置变化（本页视图树全为代码构建的线性布局，
          无需重建即可重排），而不是在 onConfigurationChanged 里 requestShowSelf() ——
          后者会和系统的 show 请求叠加，造成键盘闪现/双弹。
        -->
        <activity
            android:name="org.fcitx.fcitx5.android.ui.main.RecallActivity"
            android:exported="true"
            android:label="@string/recall"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:theme="@style/Theme.MbmActivity" />
        <!--
          MBM v1.0.35u：撤掉上面的 android:permission="${applicationId}.permission.LAUNCH"。
          原设计是「只有持有该签名级权限的调用方（主输入法）才能拉起本页」；但主包
          申请的权限名不带构建类型后缀，debug 组合下权限名对不上（…recall vs
          …recall.debug）→ SecurityException，真机表现为「已找到应用但无法打开」。
          自签免校验分发模式下该门已无意义，撤掉；页面自身仍有设备凭证门，
          数据库仍有 SQLCipher，撤此门不降低数据安全。
          <permission> 定义保留（万一第三方想重新加门），只是无人再要求它。
        -->

        <!-- 词组队列文件交给主输入法导入时使用 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- MBM v1.0.32：onnxruntime 可选遥测的初始化 Provider；本产品不启用遥测，显式移除 -->
        <provider
            android:name="ai.onnxruntime.TelemetryInitializer"
            tools:node="remove" />

        <!--
          MBM v1.0.26 加固：
           - isAccessibilityTool=false：Google Play 明确只有四类合法无障碍工具
             （屏幕阅读器/开关输入/语音输入/盲文显示），自称「无障碍工具」却做通用
             屏幕捕获会被 Play Protect 拦；如实申明为普通无障碍服务。
           - accessibilityDataSensitive：避开系统标注为「敏感数据」的窗口。
           - canTakeScreenshot/canRetrieveWindowContent：OCR 兜底所需，如实声明。
        -->
        <service
            android:name="org.fcitx.fcitx5.android.recall.RecallService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>

</manifest>
