<?xml version="1.0" encoding="utf-8"?>
<!--
  MBM v1.0.31：FileProvider 路径配置。
  仅暴露 cache/share（大文本剪贴板条目分享用的临时文件目录）。
-->
<paths>
    <cache-path name="share" path="share/" />
    <!-- Recall 屏幕记忆：导出/分享用的临时目录（词组导出、记录分享） -->
    <cache-path name="recall_export" path="." />
    <!-- MBM v1.0.73：用户自定义图像表情资产（filesDir/custom_emoji/）。
         仅供 Rich Content API 以 content:// URI 临时授权提交，不导出、不联网。 -->
    <files-path name="custom_emoji" path="custom_emoji/" />
</paths>
