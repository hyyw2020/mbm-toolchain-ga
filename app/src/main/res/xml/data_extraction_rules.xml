<?xml version="1.0" encoding="utf-8"?>
<!--
  MBM v1.0.26：
  - android:allowBackup="false"（P2-7）：默认即全部排除，以下为「双保险」排除。
  - Recall 捕获库/审计日志已随拆包迁往 org.fcitx.fcitx5.android.plugin.recall，
    那边有自己的整包禁备份规则。
  - 用户词库、自定义词组、短语锁等仍在本包，一律排除，禁止云备份/换机迁移。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="datastore" />
        <exclude domain="file" path="usr" />
        <exclude domain="file" path="descriptor.json" />
        <exclude domain="file" path="licenses.json" />
        <exclude domain="file" path="README.md" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="datastore" />
        <exclude domain="file" path="usr" />
        <exclude domain="file" path="descriptor.json" />
        <exclude domain="file" path="licenses.json" />
        <exclude domain="file" path="README.md" />
    </device-transfer>
</data-extraction-rules>
