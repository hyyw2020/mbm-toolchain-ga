<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.FcitxAppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorLogFatal">@color/red_A700</item>
        <item name="colorLogError">@color/red_400</item>
        <item name="colorLogWarning">@color/yellow_800</item>
        <item name="colorLogInfo">@color/blue_500</item>
        <item name="colorLogDebug">@color/grey_700</item>
        <item name="colorLogVerbose">@color/grey_700</item>
    </style>

    <!-- MBM: 设置类 Activity 统一使用 Material 3 主题。
         原应用主题 Theme.FcitxAppTheme 继承自 Theme.AppCompat，
         导致 MaterialButton / SwitchMaterial / TextInputLayout 等因缺少
         Theme.MaterialComponents 上下文而崩溃（IllegalArgumentException）。 -->
    <style name="Theme.MbmActivity" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">#FF0E1116</item>
        <item name="android:statusBarColor">#FF0E1116</item>
        <item name="android:navigationBarColor">#FF0E1116</item>
    </style>

    <style name="Theme.InputViewTheme" parent="@android:style/Theme.DeviceDefault.Settings" />

    <style name="Theme.DialogTheme" parent="@android:style/Theme.DeviceDefault.Light.Dialog" />

    <style name="InputViewSnackbarTheme" parent="Theme.MaterialComponents.Light.NoActionBar" />
</resources>